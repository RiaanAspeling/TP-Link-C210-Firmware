+	/*
+	 * Publish the raw per-zone bitmap for the UI, and apply the zone mask.
+	 * A zone the user has switched off still shows as "seen" in the bitmap
+	 * (so the grid can render it) but must not raise motion, or masking a
+	 * busy corner would not stop recordings firing.
+	 */
+	uint64_t hits = 0;
+	uint64_t enable = atomic_load(&st->ivs_zone_enable);
+
+	for (int i = 0; i < total && i < RSS_IVS_MAX_ROI && i < 64; i++)
+		if (mr->ret_roi[i])
+			hits |= (uint64_t)1 << i;
+	atomic_store(&st->ivs_zone_hits, hits);
+
+	if (enable) {
+		for (int i = 0; i < total && i < RSS_IVS_MAX_ROI && i < 64; i++)
+			if (!(enable & ((uint64_t)1 << i)))
+				mr->ret_roi[i] = 0;
+	}
+
 	/* Find bounding box of active zones in the grid */
 	int min_col = gx, max_col = -1, min_row = gy, max_row = -1;
 	for (int i = 0; i < total && i < RSS_IVS_MAX_ROI; i++) {
@@ -473,6 +493,7 @@
 			pthread_mutex_lock(&st->ivs_det_lock);
 			st->ivs_detections.count = 0;
 			pthread_mutex_unlock(&st->ivs_det_lock);
+			atomic_store(&st->ivs_zone_hits, 0);
 			RSS_DEBUG("IVS: motion stopped");
 		}
 	}
