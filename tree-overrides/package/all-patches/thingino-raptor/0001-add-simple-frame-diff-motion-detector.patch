+/*
+ * Built-in frame-difference motion detector.
+ *
+ * Reads NV12 frames straight from FrameSource (the same route the JZDL
+ * standalone path uses) and compares the mean luma of each grid zone against
+ * the previous processed frame. A zone is "active" when its mean shifts by
+ * more than the sensitivity threshold.
+ *
+ * Only the Y plane is read, subsampled by SIMPLE_STEP in both axes, so the
+ * per-frame cost is a few thousand byte loads — negligible next to the
+ * encoder. Results are handed to ivs_process_move_result() in exactly the
+ * shape the vendor "move" algorithm produced, so OSD, RMD and recording
+ * behave identically.
+ */
+#define SIMPLE_STEP 4 /* sample every Nth pixel in x and y */
+
+/* sensitivity 0 (least) .. 4 (most) -> mean-luma delta required, in levels */
+static int simple_threshold(int sensitivity)
+{
+	static const int thr[5] = { 24, 16, 10, 6, 3 };
+
+	if (sensitivity < 0)
+		sensitivity = 0;
+	if (sensitivity > 4)
+		sensitivity = 4;
+	return thr[sensitivity];
+}
+
+static void *rvd_simple_thread(void *arg)
+{
+	rvd_state_t *st = arg;
+	int fs = st->ivs_fs_chn;
+	int gx = st->ivs_grid_x;
+	int gy = st->ivs_grid_y;
+	int total = st->ivs_roi_count;
+	int sensitivity = rss_config_get_int(st->cfg, "motion", "sensitivity", 3);
+	int skip = rss_config_get_int(st->cfg, "motion", "skip_frames", 5);
+	int threshold = simple_threshold(sensitivity);
+	int prev_mean[RSS_IVS_MAX_ROI];
+	bool have_prev = false;
+	uint32_t frame_no = 0;
+
+	if (skip < 0)
+		skip = 0;
+
+	RSS_INFO("IVS simple thread started (fs_chn=%d, threshold=%d)", fs, threshold);
+
+	/* Must be > 0 for GetFrame to return frames alongside the encoder. */
+	if (IMP_FrameSource_SetFrameDepth(fs, 1) != 0)
+		RSS_WARN("IVS simple: SetFrameDepth failed, detection may not work");
+
+	while (rss_running(st->running) && atomic_load(&st->ivs_active)) {
+		IMPFrameInfo *frame = NULL;
+		int ret = IMP_FrameSource_GetFrame(fs, &frame);
+		if (ret != 0 || !frame) {
+			usleep(100000);
+			continue;
+		}
+
+		/* Honour skip_frames: release promptly, do no work. */
+		if (skip > 0 && (frame_no++ % (uint32_t)(skip + 1)) != 0) {
+			IMP_FrameSource_ReleaseFrame(fs, frame);
+			continue;
+		}
+
+		const uint8_t *y = (const uint8_t *)frame->virAddr;
+		int w = (int)frame->width;
+		int h = (int)frame->height;
+
+		if (!y || w <= 0 || h <= 0) {
+			IMP_FrameSource_ReleaseFrame(fs, frame);
+			usleep(100000);
+			continue;
+		}
+
+		int cw = w / gx;
+		int ch = h / gy;
+		int mean[RSS_IVS_MAX_ROI];
+
+		if (cw <= 0 || ch <= 0) {
+			IMP_FrameSource_ReleaseFrame(fs, frame);
+			usleep(100000);
+			continue;
+		}
+
+		for (int row = 0; row < gy; row++) {
+			for (int col = 0; col < gx; col++) {
+				uint32_t sum = 0;
+				uint32_t n = 0;
+				int y0 = row * ch;
+				int x0 = col * cw;
+
+				for (int yy = y0; yy < y0 + ch; yy += SIMPLE_STEP) {
+					const uint8_t *line = y + (size_t)yy * w;
+					for (int xx = x0; xx < x0 + cw; xx += SIMPLE_STEP) {
+						sum += line[xx];
+						n++;
+					}
+				}
+				mean[row * gx + col] = n ? (int)(sum / n) : 0;
+			}
+		}
+
+		/* Frame data is not needed past this point. */
+		IMP_FrameSource_ReleaseFrame(fs, frame);
+
+		if (!have_prev) {
+			memcpy(prev_mean, mean, sizeof(int) * (size_t)total);
+			have_prev = true;
+			continue;
+		}
+
+		rss_ivs_move_result_t res;
+		memset(&res, 0, sizeof(res));
+		for (int i = 0; i < total && i < RSS_IVS_MAX_ROI; i++) {
+			int d = mean[i] - prev_mean[i];
+			if (d < 0)
+				d = -d;
+			res.ret_roi[i] = (d >= threshold) ? 1 : 0;
+		}
+
+		memcpy(prev_mean, mean, sizeof(int) * (size_t)total);
+
+		/* Reuse the vendor-move result path so downstream state matches. */
+		ivs_process_move_result(st, &res);
+	}
+
+	RSS_INFO("IVS simple thread exiting");
+	return NULL;
+}
