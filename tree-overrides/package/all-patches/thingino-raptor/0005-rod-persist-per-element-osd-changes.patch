+/* Persist a per-element [osd.<name>] key into the shared config so a later
+ * `config save` writes it out. Runtime set-element / show-element changes used
+ * to touch only the in-memory element, so they were silently lost on reboot
+ * (e.g. a chosen overlay colour reverted to white). */
+static void osd_elem_cfg_set(rod_state_t *st, const char *name, const char *key, const char *val)
+{
+	char sect[ROD_ELEM_NAME_LEN + 8];
+	snprintf(sect, sizeof(sect), "osd.%s", name);
+	rss_config_set_str(st->cfg, sect, key, val);
+}
