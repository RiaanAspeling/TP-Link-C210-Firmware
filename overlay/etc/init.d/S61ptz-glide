#!/bin/sh
# Start the ptz-glide daemon (smooth continuous PTZ for pulse-style ONVIF
# clients). Runs after S59motor so the motor module/daemon is ready.
DAEMON=/usr/sbin/ptz-glide
PIDFILE=/run/ptz-glide.pid
start() {
	echo -c 15 "Starting PTZ glide daemon"
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
}
stop() {
	# the daemon runs as "/bin/sh $DAEMON"; its process name (comm) is
	# "ptz-glide", so match that. pkill -x on the comm won't match this
	# init script's own shell.
	pkill -x ptz-glide 2>/dev/null
	rm -f "$PIDFILE"
}
case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
